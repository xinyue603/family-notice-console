[Unit]
Description=家庭通知中控台 · 主服务（看板 / 后台 / 消息接口）
After=network.target

[Service]
Type=simple
# 请将 YOUR_USER 改为实际运行用户，WorkingDirectory / ExecStart 改为实际路径
User=YOUR_USER
WorkingDirectory=/opt/family-notice-console
ExecStart=/opt/family-notice-console/venv/bin/python main.py
Restart=always
RestartSec=3
# 数据目录（数据库与上传图片）；Docker 部署由镜像统一设置
Environment=NOTIFY_DATA_DIR=/opt/family-notice-console/data

[Install]
WantedBy=multi-user.target
